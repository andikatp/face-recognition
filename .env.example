# ==============================================================================
# Application Configuration
# ==============================================================================

# Application version
APP_VERSION=1.0.1

# Face detection backend (e.g., yunet, opencv, ssd, mtcnn, retinaface)
# YuNet is recommended for performance and robustness with off-center faces
DETECTOR_BACKEND=yunet

# YuNet confidence score threshold for initial face candidate filtering
# Default: 0.5 (lowered from default 0.9 to support lower-end cameras)
yunet_score_threshold=0.5

# Minimum face detection confidence threshold (0.0 - 1.0)
MIN_FACE_CONFIDENCE=0.35

# Maximum dimension (width or height) to resize incoming images for processing
MAX_DIMENSION=640

# Environment mode: development or production
ENVIRONMENT=development

# Allowed CORS origins (comma-separated or '*' for local development)
ALLOWED_ORIGINS=*


# ==============================================================================
# Redis Cache & Anti-Replay Store Configuration
# ==============================================================================
# Format: redis://[[username]:[password]@][host]:[port]/[db]
# NOTE: If REDIS_URL is empty or not set, the app runs in OFFLINE/STANDALONE mode
#       and authentication middleware is automatically bypassed for local testing.
# Examples:
#   - Offline/Local test: REDIS_URL=
#   - Without auth: redis://localhost:6379/0
#   - With password: redis://:your_secure_password@localhost:6379/0
#   - With username and password (ACL): redis://user:your_secure_password@localhost:6379/0
#   - With TLS/SSL: rediss://:your_secure_password@redis.example.com:6380/0
REDIS_URL=redis://:your_password@localhost:6379/0

# ==============================================================================
# JWT Authentication & Redis Revocation
# ==============================================================================
JWT_SECRET_KEY=change-me-in-production-secret-key
JWT_ALGORITHM=HS256
# When true, checks Redis blacklist/revocation before accepting the token
JWT_CHECK_REDIS=true
# Prefix for blacklisted/revoked token identifiers (e.g. jti) in Redis
JWT_REDIS_BLACKLIST_PREFIX=jwt:blacklist:

